{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghrab-jazyky.github.io/language-skills-hub/data/teacher-changelog.schema.json",
  "title": "LSH teacher-facing release notes – public data contract",
  "description": "Only approved, public, pedagogically relevant changes. Drafts and internal security details must never be stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "latestAnnouncementSequence",
    "contentRevision",
    "releases"
  ],
  "properties": {
    "kind": {
      "const": "LSH_TEACHER_CHANGELOG_V1"
    },
    "schemaVersion": {
      "const": 1
    },
    "latestAnnouncementSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "contentRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "releases": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "safeText": {
      "type": "string",
      "pattern": "^[^<>\\r\\n\\u0000-\\u001f]+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "publishedAt",
        "title",
        "changes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lsh-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 96
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "publishedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "minLength": 5,
              "maxLength": 120
            }
          ]
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "category",
        "title",
        "description",
        "teacherBenefit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 96
        },
        "area": {
          "enum": [
            "hub",
            "conversation",
            "reading",
            "listening"
          ]
        },
        "category": {
          "enum": [
            "functionality",
            "content",
            "language",
            "methodology",
            "interface",
            "testing"
          ]
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "minLength": 5,
              "maxLength": 110
            }
          ]
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "minLength": 20,
              "maxLength": 700
            }
          ]
        },
        "teacherBenefit": {
          "allOf": [
            {
              "$ref": "#/$defs/safeText"
            },
            {
              "minLength": 15,
              "maxLength": 240
            }
          ]
        }
      }
    }
  }
}
